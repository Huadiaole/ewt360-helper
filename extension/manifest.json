{
  "manifest_version": 3,
  "name": "升学E网通助手",
  "version": "1.0.0",
  "description": "自动连播 / 自动过认真度检查 / 自动跳过课中选择题 / 强制倍速。把 userscript 包成浏览器扩展，免安装 Tampermonkey。",
  "author": "大肥鱼",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.ewt360.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "host_permissions": ["*://*.ewt360.com/*"]
}
